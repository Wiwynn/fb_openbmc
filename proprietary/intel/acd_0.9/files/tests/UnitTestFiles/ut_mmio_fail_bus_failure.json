{
  "cpu": "gnr",
  "AccessMethod": "/dev/peci-wire",
  "Version": "release",
  "ServiceName": "crashdump",
  "PECIHeaders": {
    "Ping": [
      "Target"
    ],
    "GetCPUID": [
      "Target"
    ],
    "RdPkgConfig": [
      "Target",
      "Index",
      "Parameter",
      "ReadLen"
    ],
    "RdEndpointConfigPCILocal": [
      "Target",
      "Seg",
      "Bus",
      "Dev",
      "Func",
      "Reg",
      "ReadLen"
    ],
    "RdEndpointConfigMMIO": [
      "Target",
      "Seg",
      "Bus",
      "Dev",
      "Func",
      "Bar",
      "AType",
      "Reg",
      "ReadLen"
    ],
    "RdIAMSR": [
      "Target",
      "Thread",
      "Address"
    ]
  },
  "DefaultState": "Enable",
  "UseSections": true,
  "MaxTimeInSec": 700,
  "Sections": [
    {
      "Uncore_MMIO": {
        "RecordEnable": true,
        "RecordType": "0x08",
        "ProductType": "0x1c",
        "Revision": "0x22",
        "SkipOnFail": false,
        "LoopOnCPU": true,
        "MaxTimeSec": 30,
        "OutputPath": "crash_data/PROCESSORS/cpu%d/uncore",
        "PreReq": {
          "Commands": [
            {
              "RdEndpointConfigPCILocal_dom": [
                {
                  "Params": [ 48, 1, 2, 3, 4, 5, 6, 4 ],
                  "Output": {
                    "Name": [
                      "cpubusno_valid"
                    ]
                  },
                  "InternalVar": "CPUBusNumValid"
                },
                {
                  "Params": [ 48, 1, 2, 3, 4, 5, 2, 4 ],
                  "Output": {
                    "Name": [ "cpubusno2" ]
                  },
                  "InternalVar": "CPUBusNum2"
                },
                {
                  "Params": [ 48, 1, 2, 3, 4, 5, 7, 4 ],
                  "Output": {
                    "Name": [
                      "cpubusno7"
                    ]
                  },
                  "InternalVar": "CPUBusNum7"
                }
              ]
            },
            {
              "RdPostEnumBus": [
                {
                  "Params": [ "CPUBusNumValid", "CPUBusNum7", 30, 16 ],
                  "Output": {
                    "Name": [ "post_enum_bus30" ]
                  },
                  "InternalVar": "PostEnumBus30",
                  "comment": "if CPUBusNumValid bit 30 is 1, then PostEnumBus30 = ((CPUBusNum7 >> 16) & 0xff)"
                },
                {
                  "Params": [ "CPUBusNumValid", "CPUBusNum2", 8, 0 ],
                  "Output": {
                    "Name": [ "post_enum_bus8" ]
                  },
                  "InternalVar": "PostEnumBus8",
                  "comment": "if CPUBusNumValid bit 8 is 1, then PostEnumBus8 = ((CPUBusNum2 >> 0) & 0xff)"
                }
              ]
            }
          ]
        },
        "Commands": [
          {
            "RdEndpointConfigMMIO": [
              {
                "Params": [ "Target", 0, "CPUBusNum7", "CPUBusNum7", "CPUBusNum7", "CPUBusNum7", 6, "0xbc93c", 4 ],
                "Output": {
                  "Name": [ "B08_D00_F0_0xbc93c" ]
                }
              },
              {
                "Params": [ "Target", 0, "PostEnumBus30", 29, 0, 0, 6, "0x2b460", 4 ],
                "Output": {
                  "Name": [ "B30_D29_F0_0x2b460" ]
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
