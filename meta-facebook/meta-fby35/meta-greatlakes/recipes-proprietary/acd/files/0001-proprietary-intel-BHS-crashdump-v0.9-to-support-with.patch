         ${NVD_LIB}
         ${PMT_LIB}
         ${PMT_MCTP_LIB}
         ${BOOST_COROUTINE}
+        ${DBUS_LIB}
     )
     # Remote Module Shared Object
     if (${REMOTE_MODULE_EXAMPLE})
@@ -432,8 +435,10 @@ endif ()
 find_package (PkgConfig REQUIRED)
 pkg_get_variable(SYSTEMD_SYSTEM_UNIT_DIR systemd systemdsystemunitdir)
 
-set (SERVICE_FILES
