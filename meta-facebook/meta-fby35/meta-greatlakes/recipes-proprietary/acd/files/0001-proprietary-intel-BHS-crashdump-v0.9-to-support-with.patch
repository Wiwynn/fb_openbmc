 PlatInfo.cpp              | 39 +++++++++++++++++++++++++++++++++++++++
 crashdump.cpp             | 25 +++++++++++++++++++++++++
 crashdump.hpp             |  6 ++++++
 utils_common_dbusplus.cpp | 23 +++++++++++++++++++++++
 utils_common_dbusplus.hpp |  4 ++++
 6 files changed, 112 insertions(+), 10 deletions(-)
 create mode 100644 PlatInfo.cpp

